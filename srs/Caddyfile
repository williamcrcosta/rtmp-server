cameras.wccosta.com.br {
    tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem

    basicauth {
        admin $2a$14$WwtAMiCSLwsruO8cENmW3uNwxOviZcQcAxDTODMQCjQPJ4bHxFFb.
    }

    reverse_proxy /api/* srs:1985

    # Proxy do HLS do MediaMTX (painel rtsp.html e HTTPS, stream e HTTP)
    # API do MediaMTX (stats do painel rtsp.html)
    handle_path /mtx-api/* {
        reverse_proxy mediamtx:9997
    }

    handle_path /mtx/* {
        reverse_proxy mediamtx:8888 {
            # MediaMTX redireciona sem o prefixo /mtx - recoloca
            header_down Location "^/(.*)$" "/mtx/$1"
        }
    }

    reverse_proxy srs:8080 {
        header_up Host {host}
        header_down Cache-Control no-cache
        header_down Access-Control-Allow-Origin *
    }
}
