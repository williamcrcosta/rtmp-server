# MediaMTX — credenciais RTSP das câmeras Intelbras iM7
# Copie para mediamtx.env e preencha as senhas reais.
# ATENÇÃO: mediamtx.env está no .gitignore — nunca comite senhas.
#
# Formato do path RTSP da iM7 (padrão Intelbras/Dahua):
#   rtsp://admin:SENHA@IP:554/cam/realmonitor?channel=1&subtype=0
#     channel=1  -> canal principal
#     subtype=0  -> stream principal (High)
#     subtype=1  -> sub-stream (Standard)
#
# A senha é a "senha do dispositivo" definida no app Mibo
# (NÃO é a chave de acesso da etiqueta).

MTX_PATHS_CAMERA1_SOURCE=rtsp://admin:SENHA_CAM1@192.168.50.27:554/cam/realmonitor?channel=1&subtype=0
MTX_PATHS_CAMERA1_SOURCEPROTOCOL=tcp

MTX_PATHS_CAMERA2_SOURCE=rtsp://admin:SENHA_CAM2@192.168.50.3:554/cam/realmonitor?channel=1&subtype=0
MTX_PATHS_CAMERA2_SOURCEPROTOCOL=tcp

MTX_PATHS_CAMERA3_SOURCE=rtsp://admin:SENHA_CAM3@192.168.50.12:554/cam/realmonitor?channel=1&subtype=0
MTX_PATHS_CAMERA3_SOURCEPROTOCOL=tcp
